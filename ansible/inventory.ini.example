# Template for ansible/inventory.ini (gitignored - a real server address stays
# out of the repo). `make inventory` fills in the VM's public IP from
# `terraform -chdir=terraform/cloud output -raw public_ip`.

[app]
vm ansible_host=129.241.101.X ansible_user=ubuntu ansible_ssh_common_args="-o StrictHostKeyChecking=accept-new"
